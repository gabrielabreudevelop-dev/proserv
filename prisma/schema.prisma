// ProServ — schema do banco (Prisma ORM 7)
// Convenções:
//  - dinheiro em Decimal(14,2); custos unitários em Decimal(14,4); nunca Float
//  - datas em UTC; exibição em America/Sao_Paulo
//  - Lucro/Prejuízo vem SEMPRE da soma de LedgerEntry (nunca é armazenado)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // URL definida em prisma.config.ts
}

// ─────────────────────────────────────────────────────────────
// Enums de domínio
// ─────────────────────────────────────────────────────────────

enum FieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

enum StockMovementType {
  ENTRADA
  SAIDA_VENDA
  AJUSTE
  DEVOLUCAO
}

enum SaleStatus {
  ABERTA
  CONCLUIDA
  CANCELADA
}

enum AppointmentStatus {
  AGENDADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

/// Retorno previsto: PENDENTE (falta contatar) → AGENDADO (tem horário) → REALIZADO,
/// ou ENCERRADO (cliente não quer, cadastro juntado...).
enum FollowUpStatus {
  PENDENTE
  AGENDADO
  REALIZADO
  ENCERRADO
}

enum LedgerKind {
  RECEITA_PRODUTO
  RECEITA_SERVICO
  CMV
  DESPESA
  ESTORNO
}

enum DashboardFocus {
  PRODUTOS
  SERVICOS
}

// ─────────────────────────────────────────────────────────────
// Autenticação (tabelas do Better Auth + plugin admin)
// `role` é string porque o plugin admin aceita múltiplos cargos
// separados por vírgula. Valores: admin | gerente | vendedor | prestador
// ─────────────────────────────────────────────────────────────

model User {
  id             String          @id
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  role           String          @default("vendedor")
  banned         Boolean?        @default(false)
  banReason      String?
  banExpires     DateTime?
  dashboardFocus DashboardFocus? // visão padrão do dashboard escolhida pelo usuário
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  sessions         Session[]
  accounts         Account[]
  sales            Sale[]
  appointments     Appointment[]     @relation("Provider")
  followUpContacts FollowUpContact[] @relation("FollowUpContacts")
  tablePrefs       TablePreference[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// Produtos e campos personalizados
// ─────────────────────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id           String    @id @default(cuid())
  sku          String    @unique
  name         String
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  salePrice    Decimal   @db.Decimal(14, 2)
  avgCost      Decimal   @default(0) @db.Decimal(14, 4) // custo médio ponderado
  stockQty     Decimal   @default(0) @db.Decimal(14, 3)
  minStock     Decimal?  @db.Decimal(14, 3)
  customFields Json      @default("{}") // valores: { "<key>": valor }
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  movements StockMovement[]
  saleItems SaleItem[]

  @@index([name])
}

/// Define quais campos personalizados existem. Criar um campo novo é um INSERT aqui,
/// sem migração. Os valores ficam em Product.customFields.
model CustomFieldDefinition {
  id               String    @id @default(cuid())
  entity           String    @default("product")
  key              String
  label            String
  type             FieldType
  options          Json? // opções de SELECT
  required         Boolean   @default(false)
  visibleByDefault Boolean   @default(true)
  position         Int       @default(0)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([entity, key])
}

/// Estado da tabela por usuário (colunas visíveis, ordem, largura).
model TablePreference {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableKey String
  state    Json

  @@unique([userId, tableKey])
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(14, 3) // positivo entra, negativo sai
  unitCost    Decimal           @db.Decimal(14, 4)
  saleId      String?
  note        String?
  createdById String
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Vendas
// ─────────────────────────────────────────────────────────────

model Sale {
  id            String     @id @default(cuid())
  number        Int        @unique @default(autoincrement())
  sellerId      String
  seller        User       @relation(fields: [sellerId], references: [id])
  status        SaleStatus @default(CONCLUIDA)
  subtotal      Decimal    @default(0) @db.Decimal(14, 2)
  discount      Decimal    @default(0) @db.Decimal(14, 2)
  total         Decimal    @db.Decimal(14, 2)
  paymentMethod String
  /// Opcional: venda de balcão não precisa identificar o comprador.
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  items         SaleItem[]

  @@index([createdAt])
  @@index([sellerId, createdAt])
  @@index([customerId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 2)
  unitCost  Decimal @db.Decimal(14, 4) // snapshot do custo médio no momento da venda
}

// ─────────────────────────────────────────────────────────────
// Serviços e agenda
// ─────────────────────────────────────────────────────────────

model Customer {
  id           String        @id @default(cuid())
  name         String
  /// Só dígitos (DDD + número). Exibido formatado.
  phone        String?
  email        String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  /// LGPD: dados pessoais apagados a pedido do cliente; o histórico financeiro fica.
  anonymizedAt DateTime?
  appointments Appointment[]
  sales        Sale[]
  followUps    FollowUp[]

  @@index([name])
  @@index([phone])
}

model Service {
  id                String        @id @default(cuid())
  name              String
  description       String?
  price             Decimal       @db.Decimal(14, 2)
  estimatedCost     Decimal       @default(0) @db.Decimal(14, 2) // insumos/comissão
  durationMin       Int
  active            Boolean       @default(true)
  /// Retorno recomendado depois de concluir (ex.: manutenção a cada 6 meses). Nulo = sem retorno.
  returnAfterMonths Int?
  /// Serviço sugerido no retorno. Nulo = o próprio serviço.
  returnServiceId   String?
  returnService     Service?      @relation("ServiceReturn", fields: [returnServiceId], references: [id], onDelete: SetNull)
  returnedBy        Service[]     @relation("ServiceReturn")
  appointments      Appointment[]
  followUps         FollowUp[]
}

model Appointment {
  id                 String            @id @default(cuid())
  serviceId          String
  service            Service           @relation(fields: [serviceId], references: [id])
  generatedFollowUps FollowUp[]        @relation("FollowUpSource")
  fulfills           FollowUp?         @relation("FollowUpAppointment")
  providerId         String
  provider           User              @relation("Provider", fields: [providerId], references: [id])
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id])
  startsAt           DateTime
  endsAt             DateTime
  status             AppointmentStatus @default(AGENDADO)
  chargedPrice       Decimal?          @db.Decimal(14, 2)
  paymentMethod      String?
  notes              String?
  createdById        String?
  createdAt          DateTime          @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?

  @@index([startsAt])
  @@index([providerId, startsAt])
  @@index([status, startsAt])
  @@index([customerId, startsAt])
}

/// Retorno previsto de um cliente: quando entrar em contato e qual serviço oferecer.
model FollowUp {
  id                  String            @id @default(cuid())
  customerId          String
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId           String
  service             Service           @relation(fields: [serviceId], references: [id])
  /// Dia previsto para o contato (calendário de Brasília).
  dueOn               DateTime          @db.Date
  status              FollowUpStatus    @default(PENDENTE)
  /// Atendimento concluído que gerou este retorno (nulo = programado à mão).
  sourceAppointmentId String?
  sourceAppointment   Appointment?      @relation("FollowUpSource", fields: [sourceAppointmentId], references: [id], onDelete: SetNull)
  /// Atendimento marcado para cumprir o retorno.
  appointmentId       String?           @unique
  appointment         Appointment?      @relation("FollowUpAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  closedReason        String?
  closedAt            DateTime?
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt
  contacts            FollowUpContact[]

  @@index([status, dueOn])
  @@index([customerId, status])
}

/// Cada tentativa de contato de um retorno.
model FollowUpContact {
  id         String   @id @default(cuid())
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  /// WHATSAPP | LIGACAO | OUTRO
  channel    String
  /// SEM_RESPOSTA | FALAR_DEPOIS | VAI_AGENDAR | NAO_QUER
  outcome    String
  note       String?
  userId     String
  user       User     @relation("FollowUpContacts", fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([followUpId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Financeiro — livro-razão
// ─────────────────────────────────────────────────────────────

model LedgerEntry {
  id              String     @id @default(cuid())
  kind            LedgerKind
  amount          Decimal    @db.Decimal(14, 2) // receita +, custo/despesa -
  occurredAt      DateTime
  description     String
  category        String?
  saleId          String?
  appointmentId   String?
  stockMovementId String?
  /// Estorno: aponta para o lançamento que este anula (no máximo um estorno por lançamento).
  reversesId      String?    @unique
  createdById     String
  createdAt       DateTime   @default(now())

  @@index([occurredAt])
  @@index([kind, occurredAt])
  @@index([saleId])
  @@index([appointmentId])
}

// ─────────────────────────────────────────────────────────────
// Auditoria — quem fez o quê e quando. Só cresce: nada é editado ou apagado,
// exceto a remoção de dados pessoais de um cliente a pedido dele (LGPD).
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  action    String // ex.: venda.cancelar, produto.editar, usuario.bloquear
  entity    String // ex.: Sale, Product, User
  entityId  String?
  summary   String // frase legível: "Cancelou a venda nº 25 (R$ 100,00): cliente desistiu"
  changes   Json? // { campo: [antes, depois] } quando houver
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
